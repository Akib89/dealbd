# Add these overrides to Laravel's own generated .env
APP_NAME=DealBD
APP_URL=http://localhost:8000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dealbd
DB_USERNAME=dealbd
DB_PASSWORD=change-this-password
QUEUE_CONNECTION=database
# Required only if deploying via Docker Compose:
# MYSQL_ROOT_PASSWORD=change-this-root-password
# Only temporarily while creating admin via seed:
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=replace-with-a-unique-random-strong-password
DEALBD_TIMEZONE=Asia/Dhaka
